{
  "name": "browserport",
  "version": "0.2.1",
  "description": "A cross-platform browser picker utility",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "author": "jcyrus",
  "license": "BSD-3-Clause",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "electron:dev": "vite --mode development",
    "electron:build": "vite build && electron-builder",
    "build:mas": "tsc && vite build && electron-builder --mac mas --universal"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.16",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.7",
    "electron-updater": "^6.8.9",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "postcss": "^8.4.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^3.3.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.browserport.app",
    "productName": "BrowserPort",
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "en"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "LSUIElement": true,
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web Browser",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ],
            "LSHandlerRank": "Owner"
          },
          {
            "CFBundleURLName": "Local File URL",
            "CFBundleURLSchemes": [
              "file"
            ],
            "LSHandlerRank": "Owner"
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML Document",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "public.html",
              "public.xhtml"
            ],
            "LSHandlerRank": "Owner"
          }
        ]
      }
    },
    "mas": {
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.mas.plist",
      "entitlementsInherit": "build/entitlements.mac.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "sign": true
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icons/512x512.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "afterAllArtifactBuild": "build/notarizeDmg.cjs"
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
